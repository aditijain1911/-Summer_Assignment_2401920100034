class Solution {
    public void helper(Node root, ArrayList<Integer> ans ){
        
        if(root == null) return;
        helper(root.left, ans);
        ans.add(root.data);
        helper(root.right, ans);
    }
    public ArrayList<Integer> inOrder(Node root) {
        // code here
        ArrayList<Integer> ans = new ArrayList<>();
        if(root == null) return ans;
        helper(root, ans);
        return ans;
    }
}
